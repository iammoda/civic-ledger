# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civic_platform
REDIS_URL=redis://localhost:6379/0
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
# Public site origin (canonical URLs, sitemap, OG cards).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- App mode ---
APP_ENV=development
# Debug returns tracebacks to clients. NEVER true in production.
APP_DEBUG=true

# --- AI (Claude for analysis/extraction, OpenAI for embeddings only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Hard monthly LLM budget cap in USD; jobs refuse to run past it.
LLM_MONTHLY_BUDGET_USD=200

# --- Abuse protection (public, anonymous endpoints) ---
# Per-IP rate limits on /ask, /actions/letter, /corrections, /search.
RATE_LIMIT_ENABLED=true
# Cached Ask answers: identical questions are answered for free. 0 = off.
ASK_CACHE_TTL_SECONDS=86400
# Site-wide cap on freshly generated Ask answers per day; past it Ask
# degrades to search-only (cached answers keep working).
ASK_DAILY_GENERATE_LIMIT=300

# --- Admin (integrity review queue + corrections triage) ---
# Static shared secret sent as the X-Admin-Token header. Unset = admin disabled.
ADMIN_API_TOKEN=

# --- Observability ---
# Sentry error reporting (API + worker). Empty = disabled, zero external calls.
SENTRY_DSN=

# --- MP budget context (Follow the money) ---
# Members' Office Budget: the annual, BOIE-set office budget every MP gets
# (staff, riding office, some travel). Confirm the current base amount in the
# Members' Allowances and Services Manual (ourcommons.ca/boie) and set it here.
# Leave 0 to hide budget-utilization bars rather than show a wrong number.
MOB_ANNUAL_BUDGET=0
# MP base sessional allowance (annual salary). Same deal: confirm, then set.
MP_ANNUAL_SALARY=0

# --- Ingestion ---
INGESTION_USER_AGENT=civic-ledger/0.1 (+https://github.com/placeholder/civic-ledger)
DEFAULT_JURISDICTION=ca
DEFAULT_CHAMBER=house
# Registry of Lobbyists communications export (relational ZIP of 5 CSVs).
# NOTE: lobbycanada.gc.ca sits behind Cloudflare — scripted downloads may
# 403. Drop a manually-downloaded copy in IMPORTS_DIR as a fallback.
LOBBY_EXPORT_URL=https://lobbycanada.gc.ca/media/mqbbmaqk/communications_ocl_cal.zip
# Elections Canada contributions bulk export (113MB zip, 2.1GB CSV inside).
CONTRIBUTIONS_EXPORT_URL=https://www.elections.ca/fin/oda/od_cntrbtn_audt_e.zip
# Local directory checked FIRST for manually-downloaded export files.
IMPORTS_DIR=/Volumes/CivicLedgerData/imports
# Ignore influence records older than this year (files go back to 2004/2008).
INFLUENCE_SINCE_YEAR=2019

# --- Expense flag thresholds (review-gated detectors) ---
# Big-ticket single line items, by category (CAD).
EXPENSE_BIG_CONTRACT=25000
EXPENSE_BIG_HOSPITALITY=5000
EXPENSE_BIG_TRAVEL=15000
# Quarterly category total vs caucus median: multiplier + absolute floor.
EXPENSE_OUTLIER_MULTIPLIER=2.5
EXPENSE_OUTLIER_FLOOR=10000
