# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civic_platform
REDIS_URL=redis://localhost:6379/0
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# --- AI (Claude for analysis/extraction, OpenAI for embeddings only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Hard monthly LLM budget cap in USD; jobs refuse to run past it.
LLM_MONTHLY_BUDGET_USD=200

# --- Auth (better-auth in frontend; Google OAuth only, no email) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same DB as DATABASE_URL, node-postgres format (used by better-auth)
PG_DATABASE_URL=postgres://postgres:postgres@localhost:5432/civic_platform

# --- Ingestion ---
INGESTION_USER_AGENT=civic-ledger/0.1 (+https://github.com/placeholder/civic-ledger)
DEFAULT_JURISDICTION=ca
DEFAULT_CHAMBER=house
# Registry of Lobbyists communications export (relational ZIP of 5 CSVs).
# NOTE: lobbycanada.gc.ca sits behind Cloudflare — scripted downloads may
# 403. Drop a manually-downloaded copy in IMPORTS_DIR as a fallback.
LOBBY_EXPORT_URL=https://lobbycanada.gc.ca/media/mqbbmaqk/communications_ocl_cal.zip
# Elections Canada contributions bulk export (113MB zip, 2.1GB CSV inside).
CONTRIBUTIONS_EXPORT_URL=https://www.elections.ca/fin/oda/od_cntrbtn_audt_e.zip
# Local directory checked FIRST for manually-downloaded export files.
IMPORTS_DIR=/Volumes/CivicLedgerData/imports
# Ignore influence records older than this year (files go back to 2004/2008).
INFLUENCE_SINCE_YEAR=2019

# --- Admin (integrity review queue + corrections triage) ---
# Comma-separated emails of Google accounts with admin access.
ADMIN_EMAILS=
